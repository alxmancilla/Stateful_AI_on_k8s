# Environment variables for the Stateful-AI-on-Kubernetes demo.
#
# Copy this file to `.env` and fill in your own values, then run setup.sh:
#
#   cp .env.example .env
#   # edit .env
#   bash scripts/setup.sh
#
# setup.sh auto-loads .env from the repo root if it exists. `.env` is gitignored
# so your real keys are never committed. Values here are placeholders only.

# --- Required: external API credentials --------------------------------------
# Voyage embeddings (voyage-3) + reranking (rerank-2.5), accessed through the
# MongoDB Atlas Embedding and Reranking API. This is a MongoDB Atlas model API
# key (created in the Atlas UI), NOT a native voyageai.com "pa-..." key.
VOYAGE_API_KEY="your-atlas-model-api-key"

# Azure Grove LLM gateway (OpenAI-compatible). The key is sent via the
# "api-key" header; the endpoint is the base URL ending in /openai/v1.
AZURE_GROVE_API_KEY="your-azure-grove-api-key"
AZURE_GROVE_ENDPOINT="https://your-grove-host/openai/v1"

# --- Optional: LLM routing (defaults shown) ----------------------------------
# Provider selects the LangChain client: openai | anthropic.
LLM_PROVIDER="openai"
# Model name as exposed by your Azure Grove gateway.
LLM_MODEL_NAME="gpt-5.5"

# Voyage API base. Defaults to the MongoDB Atlas endpoint, which is what Atlas
# model API keys require. Set to https://api.voyageai.com/v1 only if you are
# using a native voyageai.com key instead.
VOYAGE_API_BASE="https://ai.mongodb.com/v1"

# --- Optional: demo/chaos script tuning (defaults shown) ---------------------
# Local port used by demo.sh / chaos.sh for the agent port-forward.
LOCAL_PORT="8080"
# Conversation session id used by the walkthrough scripts.
SESSION_ID="meetup-demo"
